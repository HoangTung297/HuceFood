<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.foodorder">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:allowBackup="true"
        android:icon="@drawable/logo"
        android:label="HUCE FOOD"
        android:roundIcon="@drawable/logo"
        android:theme="@style/Theme.FoodOrder">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FoodOrder.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LoginActivity" />
        <activity android:name=".RegisterActivity" />
        <activity android:name=".HomeActivity" />
        <activity android:name=".CartActivity" />
        <!-- <activity android:name=".OrderHistoryActivity" /> -->
        <activity android:name=".FoodDetailActivity" />
        <activity android:name=".RestaurantDetailActivity" />
        <activity android:name=".SearchActivity" />

    </application>

</manifest>