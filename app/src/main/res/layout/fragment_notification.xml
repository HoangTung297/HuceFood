<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- TOOLBAR -->
    <!-- Khung 1: HUCE FOOD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FF5722"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HUCE FOOD"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />



    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/btnFilterAll"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Tất cả"
            android:textSize="12sp"
            android:paddingHorizontal="2dp"
            android:tag="all" />

        <Button
            android:id="@+id/btnFilterOrder"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Đơn hàng"
            android:textSize="12sp"
            android:paddingHorizontal="2dp"
            android:tag="order" />

        <Button
            android:id="@+id/btnFilterPromotion"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Khuyến mãi"
            android:textSize="11sp"
            android:paddingHorizontal="2dp"
            android:tag="promotion" />

    </LinearLayout>

    <!-- ACTION BUTTONS - CHỈ CÒN NÚT ĐÁNH DẤU ĐÃ ĐỌC -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnMarkAllRead"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Đánh dấu đã đọc"
            android:textSize="13sp"
            android:background="@drawable/bg_button_outline"
            android:textColor="@color/primary_color" />

    </LinearLayout>

    <!-- SELECTION BAR - VẪN CẦN CHO CHỨC NĂNG XÓA -->
    <LinearLayout
        android:id="@+id/layoutSelectionBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/primary_color"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSelectionCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Đã chọn 0 thông báo"
            android:textSize="14sp"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnDeleteSelected"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Xóa"
            android:textSize="13sp"
            android:background="@drawable/bg_button_white"
            android:textColor="@color/primary_color" />

        <Button
            android:id="@+id/btnCancelSelection"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:text="Hủy"
            android:textSize="13sp"
            android:background="@drawable/bg_button_white"
            android:textColor="@color/primary_color" />

    </LinearLayout>

    <!-- RECYCLER VIEW -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotifications"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <!-- EMPTY STATE -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_notification"
            android:alpha="0.4" />

        <TextView
            android:id="@+id/tvEmptyMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Bạn chưa có thông báo nào"
            android:textSize="16sp"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

    <!-- PROGRESS BAR -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</LinearLayout>