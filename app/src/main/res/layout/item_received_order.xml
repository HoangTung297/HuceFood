<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header: Mã đơn và trạng thái -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mã: #ORD001"
                android:textSize="12sp"
                android:textColor="#757575" />

        </LinearLayout>

        <!-- Ngày đặt -->
        <TextView
            android:id="@+id/tvOrderDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="26/05/2024 09:39"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginTop="4dp" />

        <!-- Tên nhà hàng -->
        <TextView
            android:id="@+id/tvRestaurantName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pizza Hut"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="8dp" />

        <!-- Danh sách món ăn -->
        <TextView
            android:id="@+id/tvFoodItems"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Pizza Hải Sản x1"
            android:textSize="13sp"
            android:textColor="#757575"
            android:layout_marginTop="4dp" />

        <!-- Giá tiền -->
        <TextView
            android:id="@+id/tvTotalPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="118,200đ"
            android:textSize="16sp"
            android:textColor="#FF5722"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <!-- Nút đặt lại với ProgressBar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnReorder"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="ĐẶT LẠI"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#4CAF50"
                android:textColor="@android:color/white"
                android:visibility="visible" />

            <ProgressBar
                android:id="@+id/progressBarReorder"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>